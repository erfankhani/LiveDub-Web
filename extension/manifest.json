{
  "manifest_version": 3,
  "name": "LiveDub — دوبله زنده تب",
  "version": "2.0.0",
  "description": "دوبله و ترجمه زنده صدای تب با Gemini Live Translate — بدون قطعی، با اتصال مجدد خودکار و زیرنویس زنده",
  "permissions": ["tabCapture", "storage", "offscreen"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "wss://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LiveDub — دوبله زنده",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
